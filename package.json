{
  "name": "dopbase",
  "private": true,
  "version": "0.0.8",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "app": "cargo run --manifest-path app/Cargo.toml -- serve",
    "dev": "bun ./scripts/dev.ts",
    "dev:app": "bun run app",
    "dev:ui": "bun ./node_modules/vite/bin/vite.js",
    "typecheck:native": "tsc -b --incremental false",
    "typecheck:vue": "vue-tsc -b",
    "typecheck": "bun run typecheck:native && bun run typecheck:vue",
    "build": "bun run typecheck && vite build",
    "build:binary": "bun run build && cargo build --manifest-path app/Cargo.toml --release",
    "test:installer": "sh scripts/install.test.sh",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && bun ./scripts/docs-postbuild.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-i18n": "11",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@~7.0.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.10",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
